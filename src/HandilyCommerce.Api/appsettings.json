{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "RoutePrefix": "api",
    "Version": "v1",
    "Title": "Handily Commerce API"
  },
  "Resend": {
    "From": "Handily Commerce <onboarding@resend.dev>"
  },
  "LeadNotification": {
    "To": "ajksys@protonmail.com",
    "Subject": "[NOVO CONTATO] - Lead BCC",
    "MaxAttempts": 5,
    "BaseDelaySeconds": 30,
    "PollIntervalSeconds": 30
  },
  "RateLimiting": {
    "Leads": {
      "Enabled": true,
      "PermitLimit": 5,
      "WindowSeconds": 600,
      "SegmentsPerWindow": 10
    }
  },
  "ConnectionStrings": {
    "Default": ""
  }
}
