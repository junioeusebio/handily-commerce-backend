<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>handily-commerce-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Grafana.Loki" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplicationFactory<Program> in Api.Tests (top-level Program is internal). -->
    <InternalsVisibleTo Include="HandilyCommerce.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HandilyCommerce.Application\HandilyCommerce.Application.csproj" />
    <ProjectReference Include="..\HandilyCommerce.Infrastructure\HandilyCommerce.Infrastructure.csproj" />
  </ItemGroup>

</Project>
